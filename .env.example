# Copy to .env.local (never commit real values)

# Leave empty to use the in-memory backend (one server only)
REDIS_URL=

# Optional, see the settings table in README.md
# RATE_LIMIT_ALGORITHM=token_bucket   (fixed_window, sliding_window, sliding_counter)
# IP_LIMIT=60/1m
# USER_LIMIT=10/10s
# TRUSTED_IP_HEADER=x-real-ip
# IP_ALLOWLIST=10.0.0.0/8
# LOCAL_FALLBACK=true
# FAIL_OPEN=true
# METRICS_TOKEN=
# REDIS_TIMEOUT_MS=250
